#!/usr/bin/env bash
# Regenerates ~/.config/hypr/monitors.lua from the monitors in ~/.config/desktop/displays.json
# (written by the settings window's Displays page after you press "Keep").
set -euo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
json="$cfg/desktop/displays.json"
out="$cfg/hypr/monitors.lua"
[ -s "$json" ] || exit 0
[ "$(jq '.monitors // {} | length' "$json")" -gt 0 ] || exit 0

{
    echo "-- Generated by the Quickshell settings window (Displays) on $(date '+%F %T')."
    echo "-- Edit there (SUPER+I) - changes here are overwritten. Source: ~/.config/desktop/displays.json"
    echo
    jq -r '.monitors | to_entries | sort_by(.value.x // 0)[] |
        "hl.monitor({\n    output = \"\(.key)\",\n    mode = \"\(.value.mode)\",\n    position = \"\(.value.x)x\(.value.y)\",\n    scale = \(.value.scale),\n    vrr = \(.value.vrr)\n})"' "$json"
} >"$out.tmp"
cat "$out.tmp" >"$out"
rm -f "$out.tmp"
