#!/usr/bin/env bash
# apply-terminal-font "<family>" <size>  -> ~/.config/kitty/settings-font.conf, then live-reload kitty
set -euo pipefail
out="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/settings-font.conf"
family="${1:?family}"; size="${2:?size}"
printf '# generated by the Quickshell settings window\nfont_family %s\nfont_size %s\n' "$family" "$size" >"$out"
pkill -USR1 -x kitty || true
