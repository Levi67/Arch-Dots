#!/usr/bin/env bash
# Generates the Quickshell + kitty theme from the current wallpaper (image or video).
# Usage: wallpaper-theme [file]   (no argument = use ~/.cache/wallpaper/current)
set -uo pipefail

tag="theme"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper"
state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
logfile="$state/wallpaper.log"

mkdir -p "$cache" "$state"

# ---- logging: stderr (-> journal / terminal) + log file ----
log()  { local lvl="$1"; shift; printf '%s [%s] [%-5s] %s\n' "$(date '+%F %T')" "$tag" "$lvl" "$*" | tee -a "$logfile" >&2; }
fail() { log ERROR "$*"; exit 1; }
# run a command, log it and its output, return its exit code
run() {
    log CMD "$*"
    local out rc
    out="$("$@" 2>&1)"; rc=$?
    LAST_OUT="$out"
    [ -n "$out" ] && log OUT "$(printf '%s' "$out" | tr '\n' '|')"
    [ $rc -ne 0 ] && log ERROR "exit code $rc: $1"
    return $rc
}

LAST_OUT=""
t0=$(date +%s%3N)
log INFO "=== theme generation started (pid $$) ==="

for cmd in file ffmpeg wallust; do
    command -v "$cmd" >/dev/null || fail "missing dependency: $cmd"
done

# ---- find the wallpaper ----
src="${1:-}"
if [ -z "$src" ]; then
    log INFO "no argument given, reading $cache/current"
    src="$(cat "$cache/current" 2>/dev/null || true)"
fi
[ -n "$src" ] || fail "no wallpaper path (argument empty and $cache/current missing)"
[ -f "$src" ] || fail "wallpaper file not found: $src"

mime="$(file --mime-type -b "$src")"
log INFO "source: $src ($(du -h "$src" | cut -f1), $mime)"

# which second of a video to grab the colors from
frame_at="${FRAME_AT:-3}"

# ---- get an image to take colors from ----
case "$mime" in
    video/*|image/gif)
        img="$cache/frame.png"
        log INFO "video/gif detected -> extracting frame at ${frame_at}s to $img"
        rm -f "$img"
        run ffmpeg -y -loglevel error -ss "$frame_at" -i "$src" -frames:v 1 "$img" || true
        if [ ! -s "$img" ]; then
            log WARN "no frame at ${frame_at}s (clip shorter than that?), falling back to the first frame"
            run ffmpeg -y -loglevel error -i "$src" -frames:v 1 "$img" || fail "ffmpeg could not extract any frame"
        fi
        [ -s "$img" ] || fail "frame extraction produced no file"
        log INFO "frame ready: $img ($(du -h "$img" | cut -f1))"
        ;;
    image/*)
        img="$src"
        log INFO "image detected -> using it directly"
        ;;
    *)
        fail "unsupported file type: $mime"
        ;;
esac

# ---- generate the theme ----
log INFO "running wallust on $img"
run wallust run -q "$img" || fail "wallust failed (check ~/.config/wallust/wallust.toml and templates)"

# wallust prints [W] warnings (e.g. missing template) but still exits 0
if printf '%s' "$LAST_OUT" | grep -q '\[[WE]\]'; then
    log WARN "wallust reported problems (see OUT line above) -> a template or target in ~/.config/wallust/wallust.toml is wrong"
fi

# ---- verify the outputs were really rewritten just now ----
qs_theme="$HOME/.config/quickshell/theme/Theme.qml"
kitty_colors="$HOME/.config/kitty/wallust-colors.conf"
cava_theme="$HOME/.config/cava/themes/wallust"
now=$(date +%s)
for f in "$qs_theme" "$kitty_colors" "$cava_theme"; do
    if [ ! -f "$f" ]; then
        log WARN "NOT FOUND: $f (check the targets in wallust.toml)"
    elif [ $(( now - $(stat -c %Y "$f") )) -gt 30 ]; then
        log WARN "STALE: $f was NOT updated this run (last modified $(date -r "$f" '+%F %T'))"
    else
        log INFO "updated: $f"
    fi
done

if [ -f "$kitty_colors" ]; then
    get() { awk -v k="$1" '$1==k{print $2}' "$kitty_colors"; }
    log INFO "palette: background=$(get background) foreground=$(get foreground) accent(color4)=$(get color4) inactive(color8)=$(get color8)"
fi

# ---- reload kitty (Quickshell reloads itself when Theme.qml changes) ----
if pkill -USR1 -x kitty; then
    log INFO "sent reload signal (SIGUSR1) to kitty"
else
    log WARN "no kitty process running, nothing to reload"
fi

# ---- reload cava (colors only) ----
if pkill -USR2 -x cava; then
    log INFO "sent color reload signal (SIGUSR2) to cava"
else
    log WARN "no cava process running, nothing to reload"
fi

log INFO "=== done in $(( $(date +%s%3N) - t0 ))ms ==="
