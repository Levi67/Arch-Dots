#!/usr/bin/env bash
# term-theme - color the starship prompt and fastfetch to match the desktop theme.
#
# Palette: winter mode on -> icy palette; otherwise the wallust palette
# (~/.cache/term-theme/wallust.palette, written by the wallust "term_theme" template).
# Writes ~/.cache/term-theme/{starship.toml,fastfetch.args}, then tells every
# open interactive fish to repaint its prompt (SIGUSR2, see config.fish).
#
# Called by wallpaper-theme (after wallust) and winterctl (on every change).
set -uo pipefail

CFG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
OUT="${XDG_CACHE_HOME:-$HOME/.cache}/term-theme"
PIDS="${XDG_RUNTIME_DIR:-/tmp}/term-theme/fish"
mkdir -p "$OUT"

# defaults (slate blue), overridden below
accent="#7c839e" branch="#a6adc8" status="#e5c07b" muted="#6c7086"

winter_on() {
    local d="$CFG_HOME/quickshell/defaults/winter.json" c="$CFG_HOME/desktop/winter.json"
    [[ -s $d ]] || d=/dev/null; [[ -s $c ]] || c=/dev/null
    [[ "$(jq -rs '((.[0] // {}) * (.[1] // {})).enabled // false' "$d" "$c" 2>/dev/null)" == true ]]
}

if winter_on; then
    accent="#a9dcf5" branch="#e2f4fd" status="#c8b6ff" muted="#7f9cb0"
elif [[ -s "$OUT/wallust.palette" ]]; then
    while IFS='=' read -r k v; do
        [[ $v =~ ^#[0-9A-Fa-f]{6}$ ]] || continue
        case $k in accent|branch|status|muted) printf -v "$k" '%s' "$v" ;; esac
    done <"$OUT/wallust.palette"
fi

# starship: the repo config with its [palettes.term] block swapped out
src="$CFG_HOME/starship.toml"
tmp=$(mktemp "$OUT/.starship.XXXXXX")
{
    sed '/^# --- palette:/,$d' "$src"
    printf '# --- palette: generated by term-theme ---\n[palettes.term]\n'
    printf 'accent = "%s"\nbranch = "%s"\nstatus = "%s"\nmuted = "%s"\n' "$accent" "$branch" "$status" "$muted"
} >"$tmp" && mv -f "$tmp" "$OUT/starship.toml"

# fastfetch: one argument per line (fish_greeting reads it with `cat`)
printf '%s\n' --logo-color-1 "$accent" --logo-color-2 "$accent" \
    --color-keys "$accent" --color-title "$accent" >"$OUT/fastfetch.args"

# repaint open prompts; drop pids of shells that are gone
if [[ -d $PIDS ]]; then
    for f in "$PIDS"/*; do
        [[ -e $f ]] || continue
        pid=${f##*/}
        if [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == fish ]]; then
            kill -USR2 "$pid" 2>/dev/null
        else
            rm -f "$f"
        fi
    done
fi
