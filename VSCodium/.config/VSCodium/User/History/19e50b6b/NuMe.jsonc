{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "────────────"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "36"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "36"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "36"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "36"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "36"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "34"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "34"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "34"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}