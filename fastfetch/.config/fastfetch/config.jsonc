{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    // Matches the slate-blue/lavender hue from your image (#7c839e)
    "color": {
      "1": "38;2;124;131;158",
      "2": "38;2;124;131;158"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9
    }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "────────────" },
    { "type": "os", "key": "OS", "keyColor": "90", "format": "{name}" },
    { "type": "kernel", "key": "Kernel", "keyColor": "90", "format": "{release}" },
    { "type": "uptime", "key": "Uptime", "keyColor": "90" },
    { "type": "packages", "key": "Packages", "keyColor": "90" },
    { "type": "wm", "key": "WM", "keyColor": "90", "format": "{pretty-name}" },
    { "type": "cpu", "key": "CPU", "keyColor": "34", "format": "{name}" },
    { "type": "gpu", "key": "GPU", "keyColor": "34", "format": "{name}", "hideType": "integrated" },
    { "type": "memory", "key": "Memory", "keyColor": "34" }
  ]
}
